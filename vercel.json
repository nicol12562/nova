{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/chat", "destination": "/chat/index.html" },
    { "source": "/chat/(.*)", "destination": "/chat/$1" },
    { "source": "/planes", "destination": "/planes/index.html" },
    { "source": "/planes/(.*)", "destination": "/planes/$1" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/$1" },
    { "source": "/api", "destination": "/api/index.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/feedback", "destination": "/feedback/index.html" },
    { "source": "/feedback/(.*)", "destination": "/feedback/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
